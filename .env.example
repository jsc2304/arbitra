# Local development. Copy to packages/frontend/.env.local:
#   cp .env.example packages/frontend/.env.local
# The values below work with the Firebase emulators from `docker compose up -d firebase`.

# --- Firebase (emulators; no Google account needed) ---
GOOGLE_CLOUD_PROJECT=demo-arbitra
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-arbitra
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Artifacts are stored under .arbitra-storage/ unless GCS_BUCKET is set.

# Accounts listed here get the admin role on sign-in (comma-separated, verified emails only).
ARBITRA_ADMIN_EMAILS=alex@example.com

# Public URL of this instance. ARBITRA_PUBLIC_BASE_URL is used for device login links and
# setup snippets, ARBITRA_URL for links in notifications and commit statuses; set both.
ARBITRA_PUBLIC_BASE_URL=http://localhost:3000
ARBITRA_URL=http://localhost:3000

# --- LLM (AI review, Clerk assistant, Helper bot) ---
# Anthropic is the default provider. Without a key the app runs, but AI reviews,
# Clerk and the Helper bot fail with a provider error.
ANTHROPIC_API_KEY=
# To use OpenAI instead:
# ARBITRA_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# Optional: one model for every risk level (defaults: claude-haiku/claude-sonnet or gpt-5-mini/gpt-5.5)
# ARBITRA_LLM_MODEL=

# --- Secrets for optional features ---
# 32 random bytes, base64 (`openssl rand -base64 32`). Required to store per-repository GitHub tokens.
# ARBITRA_ENCRYPTION_KEY=
# Shared secret for the scheduled-job endpoints (sent as `Authorization: Bearer <secret>`).
# ARBITRA_CRON_SECRET=

# --- GitHub (optional) ---
# Fallback token for diff fetching and the `arbitra/case` commit status.
# GITHUB_TOKEN=
# HMAC secrets for /api/webhooks/git and /api/webhooks/ci.
# GITHUB_WEBHOOK_SECRET=
# CI_WEBHOOK_SECRET=

# --- Access control (recommended for any shared instance) ---
# Only accept Google accounts from this Workspace domain.
# AUTH_HOSTED_DOMAIN=
# NEXT_PUBLIC_AUTH_HOSTED_DOMAIN=

# --- Google Chat app (optional) ---
# CHAT_EVENTS_AUDIENCE=
# CHAT_PROJECT_NUMBER=
# ARBITRA_CHAT_REPLIES_ENABLED=false

# Env badge next to the logo on non-local hosts: prod | dev
# NEXT_PUBLIC_ARBITRA_ENV=

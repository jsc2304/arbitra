{
  "name": "arbitra-mcp",
  "version": "4.0.0",
  "description": "Arbitra MCP server \u2014 REST API bridge for AI coding agents (Claude Code, Cursor, Codex).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jsc2304/arbitra/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsc2304/arbitra.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/jsc2304/arbitra/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arbitra",
    "claude-code",
    "cursor",
    "codex"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "arbitra-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "keytar": "^7.9.0",
    "open": "^10.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
